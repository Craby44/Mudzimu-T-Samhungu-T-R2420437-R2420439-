{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run demo (main.py)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Run dashboard",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/dashboard.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Run all tests",
      "type": "debugpy",
      "request": "launch",
      "module": "unittest",
      "args": [
        "discover",
        "-v",
        "-s",
        "tests",
        "-t",
        "."
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    }
  ]
}
